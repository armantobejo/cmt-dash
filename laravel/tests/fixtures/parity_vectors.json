{
  "_meta": {
    "generated_by": "tools/gen_parity_vectors.py (runs the real Python stack)",
    "python": "3.13.7",
    "regenerate_with": [
      "python",
      "tools/gen_parity_vectors.py"
    ],
    "note": "Expected values are produced by executing the Python reference (app.auth, FastAPI, Starlette). The Laravel suite asserts equality with these values; PHP never derives an expected value from itself."
  },
  "constants": {
    "pbkdf2_iterations": 200000,
    "pbkdf2_dklen_bytes": 32,
    "session_ttl_hours": 8.0,
    "role_levels": {
      "superadmin": 5,
      "admin": 4,
      "management": 3,
      "staff": 2,
      "customer": 1
    }
  },
  "pbkdf2": [
    {
      "id": "ascii_basic",
      "pw": "pw",
      "salt": "4f0a",
      "pw_bytes_hex": "7077",
      "expected_hash": "0982733758b7db33f21cbe6bea6b569ae844b506f257035cfee5b737f516a949"
    },
    {
      "id": "unicode_pw",
      "pw": "pässwörd",
      "salt": "0a0b0c0d",
