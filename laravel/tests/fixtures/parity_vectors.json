  "json_dumps": [
    {
      "id": "ascii",
      "obj": {
        "user": "admin",
        "role": "superadmin",
        "active_db": "CMT"
      },
      "expected": "{\"user\":\"admin\",\"role\":\"superadmin\",\"active_db\":\"CMT\"}"
    },
    {
      "id": "unicode",
      "obj": {
        "msg": "Pembayaran lunas",
        "name": "PT. Trisco"
      },
      "expected": "{\"msg\":\"Pembayaran lunas\",\"name\":\"PT. Trisco\"}"
    },
    {
      "id": "slash_amp",
      "obj": {
        "url": "http://x/?a=1&b=2",
        "p": "/x/y"
      },
      "expected": "{\"url\":\"http://x/?a=1&b=2\",\"p\":\"/x/y\"}"
    },
    {
      "id": "floats_common",
      "obj": {
        "a": 0.1,
        "b": 1.0,
        "c": 1234.5678,
        "d": 3.14159265358979
      },
      "expected": "{\"a\":0.1,\"b\":1.0,\"c\":1234.5678,\"d\":3.14159265358979}",
      "note": "Python emits int-valued floats as 1.0; PHP json_encode prints 1. Spellings differ, decoded value identical"
    },
    {
      "id": "floats_edge",
      "obj": {
        "n": 1e+20
      },
      "expected": "{\"n\":1e+20}",
      "note": "Python 1e+20 vs PHP 1.0e+20 exponent spelling; P5 capture normalizer rounds floats to 4dp"
    },
    {
      "id": "null_bool",
      "obj": {
        "x": null,
        "y": true,
        "z": false
      },
      "expected": "{\"x\":null,\"y\":true,\"z\":false}"
    },
    {
      "id": "nested",
      "obj": {
        "rows": [
          {
            "a": 1
          },
          {
            "b": [
              1,
              2,
              3
            ]
          }
        ],
        "total": 2
      },
      "expected": "{\"rows\":[{\"a\":1},{\"b\":[1,2,3]}],\"total\":2}"
    }
